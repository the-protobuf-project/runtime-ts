{
  "name": "runtime-ts",
  "private": true,
  "type": "module",
  "description": "The TypeScript runtime underneath code generated from your .proto files.",
  "license": "Apache-2.0",
  "workspaces": [
    "errors",
    "protobuf",
    "network",
    "codemode"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "tsc -b && npm test --workspaces",
    "test:bun": "tsc -b && npm run test:bun --workspaces",
    "test:deno": "tsc -b && npm run test:deno --workspaces",
    "lint:lines": "./scripts/check-lines.sh",
    "clean": "rm -rf */dist"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "ai": "^7.0.179",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
