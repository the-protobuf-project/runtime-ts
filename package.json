{
  "name": "runtime-ts",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "The TypeScript runtime underneath code generated from your .proto files.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "tsc -b && bun test",
    "test:node": "tsc -b && node --test \"packages/*/test/**/*.test.ts\"",
    "test:deno": "tsc -b && deno test --no-check --allow-read --allow-env --allow-run packages/",
    "lint:lines": "./scripts/check-lines.sh",
    "clean": "rm -rf packages/*/dist",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "docs": "tsc -b && bun tools/docgen.ts",
    "docs:check": "tsc -b && bun tools/docgen.ts --check",
    "check": "bun run lint && bun run typecheck && bun run docs:check && bun run lint:lines"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "ai": "^7.0.179",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
