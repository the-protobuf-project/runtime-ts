{
  "name": "@the-protobuf-project/errors",
  "version": "0.3.0",
  "description": "gRPC status errors, and their mapping from HTTP and Connect.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-protobuf-project/runtime-ts.git",
    "directory": "packages/errors"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun test ./test",
    "test:node": "node --test \"test/**/*.test.ts\"",
    "test:deno": "deno test --no-check --allow-read --allow-env --allow-run test/"
  }
}
